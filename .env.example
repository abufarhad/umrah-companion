# Optional. Leave empty and the app runs fully offline/local-first
# (progress and trips are saved in the browser).
#
# When set, users can sign in with an email link to sync their trip plans
# across devices, and admins can override cost assumptions from the
# `app_config` table without redeploying. Supabase → Settings → API.
# Both values are public by design; data is protected by row-level security.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional - leave empty to use the free OpenStreetMap map (no key, no billing).
# Places and directions always open in Google Maps via plain links (free).
# Only set this to use the Google Maps JavaScript API instead. If you add a key:
#  - enable "Maps JavaScript API" in Google Cloud and attach a billing account;
#  - restrict the key to HTTP referrers (your domain) and to that one API;
#  - keep it in .env.local / your host's env settings - never commit it.
VITE_GOOGLE_MAPS_API_KEY=
